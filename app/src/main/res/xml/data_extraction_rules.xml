<?xml version="1.0" encoding="utf-8"?>
<!-- Данные тренировок не отправляются ни в облачную копию Google, ни при переносе между устройствами.
     Резервное копирование делается вручную: Настройки → Резервная копия. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
